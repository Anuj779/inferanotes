# Firebase web app settings (public values, included in the browser build)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase service account (server secrets, never NEXT_PUBLIC_)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Enable a currently available free model in Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional fallback for shorter transcripts
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
DAILY_GENERATION_LIMIT=10
